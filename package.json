    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "3.9.10",
    "solc": "0.8.37",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
