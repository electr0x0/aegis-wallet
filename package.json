    "setup-wallets": "tsx --env-file-if-exists=.env.local scripts/setup-wallets.ts",
    "godui:check": "node scripts/godui-mcp.mjs",
    "guard:compile": "node scripts/compile-guard.mjs",
    "guard:deploy": "tsx --env-file-if-exists=.env.local scripts/deploy-guard.ts",
    "guard:attack": "tsx --env-file-if-exists=.env.local scripts/attack-demo.ts",
    "ledger:anchor": "tsx --env-file-if-exists=.env.local scripts/anchor-ledger.ts"
  },
  "dependencies": {
    "@svg-animated-icons/react": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.3.0",
    "geist": "^1.8.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.12",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "viem": "^2.38.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@godui/mcp": "0.1.0",
