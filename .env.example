# Reference only: pnpm setup-wallets creates missing local keys in .env.local.
# Base Sepolia (84532) only. Never commit .env.local or any private key.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Server-only agent/session key; setup creates this and the vault/owner pair.
AGENT_PRIVATE_KEY=
VAULT_ADDRESS=
VAULT_PRIVATE_KEY=

# Leave blank for EOA mode. pnpm guard:deploy writes YOUR deployed guard here.
GUARD_ADDRESS=
SESSION_HOURS=24

# Optional providers, tried in this order. No key is needed for built-in scenarios.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional isolated production-build output; the default is .next.
# AEGIS_BUILD_DIR=.next-verify
